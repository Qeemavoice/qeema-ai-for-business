# ───── مساعد قيمة (أضيفي هذه الأسطر إلى ملف .env في الموقع) ─────

# المزود: anthropic (Claude) أو openai (ChatGPT)
QV_CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
QV_CHAT_ANTHROPIC_MODEL=claude-haiku-5-5
# إذا اخترتِ openai: احذفي # من السطرين واكتبي اسم أحدث نموذج صغير من OpenAI
# OPENAI_API_KEY=
# QV_CHAT_OPENAI_MODEL=

# ElevenLabs للمعاينة
ELEVENLABS_API_KEY=
QV_CHAT_PREVIEW_MODEL=eleven_flash_v2_5
# ملف mp3 قصير يقول «معاينة من قيمة فويس» (اختياري)
QV_CHAT_WATERMARK_PATH=

# حدود المعاينة
QV_CHAT_PREVIEW_MAX_CHARS=450
QV_CHAT_FREE_PREVIEWS=3

# توثيق الرقم: log للتجربة (الرمز يظهر في storage/logs/laravel.log) أو webhook للإرسال بالواتساب
QV_CHAT_OTP_ENABLED=true
QV_CHAT_OTP_DRIVER=log
QV_CHAT_OTP_WEBHOOK=

# رقم واتساب الدعم الفني بصيغة دولية بدون + (مثال: 9665XXXXXXXX)
QV_CHAT_SUPPORT_WHATSAPP=
# روابط انضمام المعلقين: صفحة إنشاء حساب معلق، ومقال «كيف أنضم إلى منصة قيمة فويس؟»
QV_CHAT_ARTIST_SIGNUP_URL=
QV_CHAT_ARTIST_GUIDE_URL=
# مدونة الموقع، والشروط وسياسة الاستخدام (يُوجَّه إليها المعلقون للإجابة عن أسئلتهم)
QV_CHAT_BLOG_URL=
QV_CHAT_TERMS_URL=

# إشعارات الطلبات الجديدة للفريق
QV_CHAT_TEAM_EMAIL=info@qeemavoice.com
QV_CHAT_NOTIFY_WEBHOOK=

# فقط إذا كانت الواجهة على نطاق مختلف عن الخادم (افصلي بفاصلة)
QV_CHAT_ALLOWED_ORIGINS=
